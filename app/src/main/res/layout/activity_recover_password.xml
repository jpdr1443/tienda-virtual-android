<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperación de contraseña por correo (Firebase Authentication) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIconTint="@color/on_primary"
        app:titleTextColor="@color/on_primary" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/accent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <ImageView
                android:layout_width="@dimen/logo_size_small"
                android:layout_height="@dimen/logo_size_small"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_l"
                android:background="@drawable/bg_circle_light"
                android:contentDescription="@string/logo_desc"
                android:padding="@dimen/spacing_m"
                android:src="@drawable/ic_person"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recover_heading"
                android:textAppearance="@style/TextAppearance.TV.Title"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recover_description"
                android:textAppearance="@style/TextAppearance.TV.Caption"
                android:layout_gravity="center_horizontal"
                android:gravity="center" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_email"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:hint="@string/hint_email"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                style="@style/Widget.TV.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/btn_send_link"
                app:cornerRadius="@dimen/corner_card" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
